<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenMagicka.Content\OpenMagicka.Content.csproj" />
    <ProjectReference Include="..\..\src\OpenMagicka.Engine\OpenMagicka.Engine.csproj" />
    <ProjectReference Include="..\..\src\OpenMagicka.Net\OpenMagicka.Net.csproj" />
    <ProjectReference Include="..\..\src\OpenMagicka.Tools\OpenMagicka.Tools.csproj" />
    <ProjectReference Include="..\..\src\OpenMagicka.Game\OpenMagicka.Game.csproj" />
    <ProjectReference Include="..\..\src\OpenMagicka.Gameplay\OpenMagicka.Gameplay.csproj" />
    <ProjectReference Include="..\..\src\OpenMagicka.Physics\OpenMagicka.Physics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- FAudio (and SDL3, which it runs on) for the sound tests (OM-51); they pass silently without them. On Windows it
       is our own build (native/README.md) with its record, so OwnFAudioTests checks our fixes there; SDL3 is the
       fnalibs' unless Sdl3Dll names another (CI's). -->
  <PropertyGroup>
    <Sdl3Dll Condition="'$(Sdl3Dll)' == ''">$(RootDir)lib/fnalibs/x64/SDL3.dll</Sdl3Dll>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) And Exists('$(Sdl3Dll)')">
    <None Include="$(RootDir)native/win-x64/FAudio.dll;$(Sdl3Dll)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(RootDir)native/win-x64/FAudio.SOURCE.txt" Link="FAudio.OpenMagicka.txt" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <None Include="$(RootDir)lib/fnalibs/lib64/libFAudio.so.0;$(RootDir)lib/fnalibs/lib64/libSDL3.so.0" Condition="Exists('$(RootDir)lib/fnalibs/lib64/libFAudio.so.0')"
      CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="$(RootDir)lib/fnalibs/osx/libFAudio.0.dylib;$(RootDir)lib/fnalibs/osx/libSDL3.0.dylib" Condition="Exists('$(RootDir)lib/fnalibs/osx/libFAudio.0.dylib')"
      CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
