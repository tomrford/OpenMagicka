     return out;
 } // metal_add_missing_varyings
 
+// OpenMagicka fork: Metal refuses a pipeline whose vertex shader reads an attribute that the
+//  vertex declaration does not supply ("Vertex attribute v3(3) is missing"), where D3D9 and
+//  GL read a default. Drop each such input from the input struct and read it as
+//  float4(0, 0, 0, 1). Returns a new source, or NULL when nothing is missing.
+static char *metal_default_missing_inputs(MOJOSHADER_sdlContext *ctx, const char *vsrc,
+                                          const MOJOSHADER_parseData *pd,
+                                          const MOJOSHADER_vertexAttribute *attrs,
+                                          int attrCount)
+{
+    char *out = NULL;
+    int i, k;
+
+    for (i = 0; i < pd->attribute_count; i++)
+    {
+        const MOJOSHADER_attribute *attr = &pd->attributes[i];
+        char field[96], define[160], repl[160];
+        int found = 0;
+
+        for (k = 0; k < attrCount; k++)
+            if (attrs[k].usage == attr->usage && attrs[k].usageIndex == attr->index)
+                found = 1;
+        if (found || attr->name == NULL)
+            continue;
+
+        const char *src = out ? out : vsrc;
+        SDL_snprintf(field, sizeof (field), "float4 %s [[attribute(", attr->name);
+        SDL_snprintf(define, sizeof (define), "#define %s input.%s", attr->name, attr->name);
+        SDL_snprintf(repl, sizeof (repl), "#define %s float4(0.0, 0.0, 0.0, 1.0)", attr->name);
+        const char *fieldAt = SDL_strstr(src, field);
+        const char *defineAt = fieldAt ? SDL_strstr(fieldAt, define) : NULL;
+        if (defineAt == NULL)
+            continue;
+
+        const char *lineStart = fieldAt;
+        while (lineStart > src && lineStart[-1] != '\n')
+            lineStart--;
+        const char *lineEnd = SDL_strchr(fieldAt, '\n');
+        lineEnd = lineEnd ? lineEnd + 1 : fieldAt + SDL_strlen(fieldAt);
+
+        const size_t cap = SDL_strlen(src) + SDL_strlen(repl) + 1;
+        char *next = (char *) ctx->malloc_fn(cap, ctx->malloc_data);
+        if (next == NULL)
+            break;
+        size_t at = lineStart - src;
+        SDL_memcpy(next, src, at);
+        SDL_memcpy(next + at, lineEnd, defineAt - lineEnd);
+        at += defineAt - lineEnd;
+        SDL_memcpy(next + at, repl, SDL_strlen(repl));
+        at += SDL_strlen(repl);
+        SDL_strlcpy(next + at, defineAt + SDL_strlen(define), cap - at);
+        if (out != NULL)
+            ctx->free_fn(out, ctx->malloc_data);
+        out = next;
+    } // for
+
+    return out;
+} // metal_default_missing_inputs
